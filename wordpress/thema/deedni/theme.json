{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "achtergrond",
					"name": "Achtergrond",
					"color": "#F5F7FC"
				},
				{
					"slug": "achtergrond-2",
					"name": "Achtergrond 2 (vlakken)",
					"color": "#EBEFFA"
				},
				{
					"slug": "vlak",
					"name": "Kaarten",
					"color": "#FFFFFF"
				},
				{
					"slug": "inkt",
					"name": "Tekst (inkt)",
					"color": "#0F1A3D"
				},
				{
					"slug": "gedempt",
					"name": "Tekst gedempt",
					"color": "#4A5578"
				},
				{
					"slug": "lijn",
					"name": "Lijnen",
					"color": "#D5DBEE"
				},
				{
					"slug": "lijn-sterk",
					"name": "Lijnen sterk",
					"color": "#AEB8DB"
				},
				{
					"slug": "accent",
					"name": "Accent (knoppen en links)",
					"color": "#2842E0"
				},
				{
					"slug": "accent-tekst",
					"name": "Tekst op accent",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent-zacht",
					"name": "Accent zacht",
					"color": "#E6EAFF"
				},
				{
					"slug": "marker",
					"name": "Marker (salaris)",
					"color": "#FFE14D"
				},
				{
					"slug": "groen",
					"name": "Groen (bevestiging, match)",
					"color": "#0B7A4F"
				},
				{
					"slug": "groen-zacht",
					"name": "Groen zacht",
					"color": "#DDF3E8"
				},
				{
					"slug": "nacht",
					"name": "Donker (voet, welkom)",
					"color": "#0B1130"
				},
				{
					"slug": "nacht-2",
					"name": "Donker 2",
					"color": "#161F4A"
				},
				{
					"slug": "nacht-tekst",
					"name": "Tekst op donker",
					"color": "#EEF1FF"
				},
				{
					"slug": "nacht-accent",
					"name": "Accent op donker",
					"color": "#8EA2FF"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "instrument-sans",
					"name": "Instrument Sans",
					"fontFamily": "\"Instrument Sans\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontWeight": "400 700",
							"fontStretch": "75% 100%",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-sans.woff2"
							]
						}
					]
				},
				{
					"slug": "systeem",
					"name": "Systeemletter",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "klein",
					"name": "Klein",
					"size": "0.9375rem"
				},
				{
					"slug": "normaal",
					"name": "Normaal",
					"size": "1.0625rem"
				},
				{
					"slug": "groot",
					"name": "Groot",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "kop",
					"name": "Kop",
					"size": "2rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2rem"
					}
				},
				{
					"slug": "titel",
					"name": "Titel",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--achtergrond)",
			"text": "var(--wp--preset--color--inkt)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--instrument-sans)",
			"fontSize": "var(--wp--preset--font-size--normaal)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-tekst)"
				},
				"border": {
					"radius": "12px"
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"link": {
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "volle-breedte",
			"title": "Volle breedte (deedni-blokken)",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Kop met menu",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Voet",
			"area": "footer"
		}
	]
}
